# Environment Variables
# .env is template (safe to commit)
# .env.local.example is reference (safe to commit)
# But .env.local contains actual secrets (DO NOT COMMIT)
.env.local
.env.production
.env.production.local
.env.*.local
# Except .env.local.example which is safe reference
!.env.local.example

